# Backend for local Next.js rewrites (next.config.ts) and/or Vercel proxy.
# NestJS in trivaller-backend uses global prefix /api on PORT 8080.

# Local next remaps /api/trivaller-backend/* → ${DEV_BACKEND_ORIGIN}/api/*
DEV_BACKEND_ORIGIN=http://127.0.0.1:8080

# Browser-facing API base for the admin panel (optional).
# Prefer the same-origin proxy path in production:
# NEXT_PUBLIC_API_BASE_URL=/api/trivaller-backend
NEXT_PUBLIC_API_BASE_URL=/api/trivaller-backend

# Vercel serverless (app/api/trivaller-backend) — set in Vercel dashboard:
# BACKEND_HTTP_ORIGIN=http://YOUR_NEST_HOST:8080
